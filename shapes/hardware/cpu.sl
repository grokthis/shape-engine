// The complete shape computer. Built from the axiom up.
//
// Every component IS a shape. Every connection IS a dependency.
// Every operation IS wave propagation. The computer doesn't
// simulate computation. The computer IS computation.

shape hardware.cpu : hardware {
  type: system
  layer: 1
  "A computer built from shapes. ALU, registers, memory, bus, control. Each component is a shape that persists and propagates."
}
