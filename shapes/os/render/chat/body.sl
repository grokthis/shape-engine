shape os.render.chat.body {
  type: body
  layer: 4
  """
<div id="chat">
  <div id="chat-header">
    <span id="chat-title">Shape Agent</span>
    <span id="chat-status">ready</span>
  </div>
  <div id="chat-messages"></div>
  <div id="chat-input-area">
    <textarea id="chat-input" placeholder="Ask the agent to build shapes..." rows="1" autofocus></textarea>
    <button id="chat-send" title="Send">&#9654;</button>
  </div>
</div>
"""
}
