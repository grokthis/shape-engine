shape os.doc.app.chat : os.doc {
  type: doc
  layer: 4
  section: 4
  synopsis: "LLM chat interface"
  summary: "Talk to an LLM agent that can read and modify shapes."
  see_also: "cmd.ask, app.shell"
  """
== DESCRIPTION ==
The chat app connects to the configured LLM (Settings > LLM)
and provides an interactive conversation interface.
The agent can read shapes, create shapes, and answer
questions about the system.

== SETUP ==
1. Go to Settings
2. Enter your API key under LLM
3. Choose a model (default: claude-sonnet-4-20250514)
"""
}
