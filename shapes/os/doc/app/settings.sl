shape os.doc.app.settings : os.doc {
  type: doc
  layer: 4
  section: 4
  synopsis: "System settings"
  summary: "Configure theme, window manager, LLM, and shell settings."
  see_also: "concept.shape"
  """
== DESCRIPTION ==
Settings are shapes under os.config.* that control
system behavior. Changes take effect immediately
through wave propagation.

== SECTIONS ==
  Appearance   theme, window manager style
  LLM          API key, model, max tokens
  Desktop      default apps, startup workspace
  Shell        aliases, environment
"""
}
