shape os.doc.app.browser : os.doc {
  type: doc
  layer: 4
  section: 4
  synopsis: "Shape browser"
  summary: "Three-pane browser for navigating the shape graph."
  see_also: "concept.shape, concept.structure"
  """
== DESCRIPTION ==
The shape browser renders the graph as navigable HTML.
Left pane: tree view of all shapes by hierarchy.
Center pane: selected shape detail (content, dimensions).
Right pane: references (deps and dependents).

== NAVIGATION ==
Click any shape in the tree to view it.
Click any reference link to navigate to that shape.
"""
}
