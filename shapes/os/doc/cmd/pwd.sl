shape os.doc.cmd.pwd : os.doc {
  type: doc
  layer: 4
  section: 1
  synopsis: "pwd"
  summary: "Print current prefix (working directory)."
  see_also: "cmd.cd, cmd.ls"
  """
== DESCRIPTION ==
Prints the current shape prefix. Analogous to Unix pwd.
The prefix determines how relative shape IDs are resolved.
"""
}
