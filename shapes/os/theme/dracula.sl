shape os.theme.dracula {
  type: theme
  layer: 4
  """
:root {
  --bg: #282a36;
  --bg-dark: #1e1f29;
  --bg-lighter: #44475a;
  --fg: #f8f8f2;
  --fg-dim: #6272a4;
  --accent: #bd93f9;
  --green: #50fa7b;
  --red: #ff5555;
  --yellow: #f1fa8c;
  --border: #44475a;
  --border-focus: #bd93f9;
  --titlebar: #44475a;
  --titlebar-text: #6272a4;
  --statusbar: #1e1f29;
  --statusbar-text: #6272a4;
  --prompt: #bd93f9;
  --error: #ff5555;
  --dim: #6272a4;
  --cursor: #f8f8f2;
  --selection: #44475a;
}
"""
}
