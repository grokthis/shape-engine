shape os.theme.nord {
  type: theme
  layer: 4
  """
:root {
  --bg: #2e3440;
  --bg-dark: #242933;
  --bg-lighter: #3b4252;
  --fg: #d8dee9;
  --fg-dim: #4c566a;
  --accent: #88c0d0;
  --green: #a3be8c;
  --red: #bf616a;
  --yellow: #ebcb8b;
  --border: #3b4252;
  --border-focus: #88c0d0;
  --titlebar: #3b4252;
  --titlebar-text: #4c566a;
  --statusbar: #242933;
  --statusbar-text: #4c566a;
  --prompt: #88c0d0;
  --error: #bf616a;
  --dim: #4c566a;
  --cursor: #eceff4;
  --selection: #434c5e;
}
"""
}
