shape os.theme.catppuccin {
  type: theme
  layer: 4
  """
:root {
  --bg: #1e1e2e;
  --bg-dark: #181825;
  --bg-lighter: #313244;
  --fg: #cdd6f4;
  --fg-dim: #585b70;
  --accent: #89b4fa;
  --green: #a6e3a1;
  --red: #f38ba8;
  --yellow: #f9e2af;
  --border: #313244;
  --border-focus: #89b4fa;
  --titlebar: #313244;
  --titlebar-text: #585b70;
  --statusbar: #181825;
  --statusbar-text: #585b70;
  --prompt: #89b4fa;
  --error: #f38ba8;
  --dim: #585b70;
  --cursor: #f5e0dc;
  --selection: #45475a;
}
"""
}
