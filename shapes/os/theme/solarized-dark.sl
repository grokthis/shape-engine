shape os.theme.solarized-dark {
  type: theme
  layer: 4
  """
:root {
  --bg: #002b36;
  --bg-dark: #001e26;
  --bg-lighter: #073642;
  --fg: #839496;
  --fg-dim: #586e75;
  --accent: #268bd2;
  --green: #859900;
  --red: #dc322f;
  --yellow: #b58900;
  --border: #073642;
  --border-focus: #268bd2;
  --titlebar: #073642;
  --titlebar-text: #657b83;
  --statusbar: #001e26;
  --statusbar-text: #586e75;
  --prompt: #268bd2;
  --error: #dc322f;
  --dim: #586e75;
  --cursor: #93a1a1;
  --selection: #073642;
}
"""
}
