shape os.theme.tokyo-night {
  type: theme
  layer: 4
  """
:root {
  --bg: #1a1b26;
  --bg-dark: #16161e;
  --bg-lighter: #1f2335;
  --fg: #a9b1d6;
  --fg-dim: #565f89;
  --accent: #7aa2f7;
  --green: #9ece6a;
  --red: #f7768e;
  --yellow: #e0af68;
  --border: #292e42;
  --border-focus: #7aa2f7;
  --titlebar: #24283b;
  --titlebar-text: #737aa2;
  --statusbar: #16161e;
  --statusbar-text: #565f89;
  --prompt: #7aa2f7;
  --error: #f7768e;
  --dim: #565f89;
  --cursor: #c0caf5;
  --selection: #283457;
}
"""
}
