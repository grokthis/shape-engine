shape os.theme.gruvbox {
  type: theme
  layer: 4
  """
:root {
  --bg: #282828;
  --bg-dark: #1d2021;
  --bg-lighter: #3c3836;
  --fg: #ebdbb2;
  --fg-dim: #665c54;
  --accent: #458588;
  --green: #98971a;
  --red: #cc241d;
  --yellow: #d79921;
  --border: #3c3836;
  --border-focus: #458588;
  --titlebar: #3c3836;
  --titlebar-text: #665c54;
  --statusbar: #1d2021;
  --statusbar-text: #665c54;
  --prompt: #458588;
  --error: #cc241d;
  --dim: #665c54;
  --cursor: #fbf1c7;
  --selection: #504945;
}
"""
}
