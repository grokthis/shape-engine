shape theory.continuity : theory.transformation {
  type: theorem
  layer: 0
  """
// Theorem 3.6 (Continuity).
// Persistence requires that continuity be maintained across
// transformation: M' must be identifiable as "what M became"
// rather than an unrelated replacement.
//
// If nothing connected M to M', then M' would not be "what M became."
// It would be a replacement, not a transformation. Continuity is what
// connects M to M' as states of the same shape.
//
// Derives from: theory.transformation
  """
}
