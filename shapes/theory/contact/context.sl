shape theory.contact.context : theory.contact.self, theory.contact.mutual {
  type: definition
  layer: 0
  """
// Definition 5.4 (Context).
// The context of a shape A is the set of shapes A is in contact with.
// By Definition 5.2, A is always in its own context. Other shapes
// enter A's context through mutual contact.
//
// Derives from: theory.contact.self (A is always in own context),
//               theory.contact.mutual (others enter through mutual contact)
  """
}
