shape theory.physics.alpha : theory.physics.dof, theory.physics.u1 {
  type: theorem
  layer: 0
  """
// Theorem 9.1 (Fine Structure Constant).
// alpha = 1/137.
//
// After electroweak symmetry breaking, the photon is the unbroken
// U(1): a singular direction in gauge space. One massless gauge
// boson direction. It occupies one encoding slot in the
// 137-dimensional consumable space.
//
// alpha = 1/137: one EM encoding position divided by 137
// consumable positions.
//
// This is fundamentally different from mixing angles. The fine
// structure constant is not "what is encoded in a transition"
// but "what fraction of total state space does EM represent."
//
// Derives from: theory.physics.dof (137 consumable),
//               theory.physics.u1 (photon is unbroken U(1))
  """
}
