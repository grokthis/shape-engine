shape theory.emergence.general-composition : theory.emergence.composition {
  type: definition
  layer: 0
  """
// Definition 6.3 (Composition).
// Given shapes A and B and a structure S, the composition
// D = A compose_S B is the shape whose context references A, B,
// and D's own prior character, governed by structure S.
//
// When S is derived from coupling (emergent composition), the result
// is determined by the coupling geometry. When S is specified
// independently (general composition), the result depends on S.
//
// Proposition 6.4 (Composition Persistence): If A and B persist and
// S is well-defined on the context, the composition persists.
//
// Derives from: theory.emergence.composition
  """
}
